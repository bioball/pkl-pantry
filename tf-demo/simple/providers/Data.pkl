module providers.Data

import "@tf/tf.pkl"

import "hetznercloud/hcloud/data/Certificate.pkl"
import "hetznercloud/hcloud/data/Certificates.pkl"
import "hetznercloud/hcloud/data/Datacenter.pkl"
import "hetznercloud/hcloud/data/Datacenters.pkl"
import "hetznercloud/hcloud/data/Firewall.pkl"
import "hetznercloud/hcloud/data/Firewalls.pkl"
import "hetznercloud/hcloud/data/FloatingIp.pkl"
import "hetznercloud/hcloud/data/FloatingIps.pkl"
import "hetznercloud/hcloud/data/Image.pkl"
import "hetznercloud/hcloud/data/Images.pkl"
import "hetznercloud/hcloud/data/LoadBalancer.pkl"
import "hetznercloud/hcloud/data/LoadBalancers.pkl"
