/// Provides details about a specific Hetzner Cloud Load Balancer Type.
///
/// Use this resource to get detailed information about a specific Load Balancer Type.
module providers.hetznercloud.hcloud.data.LoadBalancerType

extends "@tf/DataSource.pkl"

import "@tf/tf.pkl"

/// Date of the Load Balancer Type deprecation announcement.
hidden fixed deprecation_announced: tf.Computed<String> =
  tf.computed<String>(this, "deprecation_announced")

/// Description of the Load Balancer Type.
hidden fixed description: tf.Computed<String> = tf.computed<String>(this, "description")

/// ID of the Load Balancer Type.
id: tf.Input<Number>?

/// Whether the Load Balancer Type is deprecated.
hidden fixed is_deprecated: tf.Computed<Boolean> = tf.computed<Boolean>(this, "is_deprecated")

/// Maximum number of certificates that can be assigned for the Load Balancer of this type.
hidden fixed max_assigned_certificates: tf.Computed<Number> =
  tf.computed<Number>(this, "max_assigned_certificates")

/// Maximum number of simultaneous open connections for the Load Balancer of this type.
hidden fixed max_connections: tf.Computed<Number> = tf.computed<Number>(this, "max_connections")

/// Maximum number of services for the Load Balancer of this type.
hidden fixed max_services: tf.Computed<Number> = tf.computed<Number>(this, "max_services")

/// Maximum number of targets for the Load Balancer of this type.
hidden fixed max_targets: tf.Computed<Number> = tf.computed<Number>(this, "max_targets")

/// Name of the Load Balancer Type.
name: tf.Input<String>?

/// Date of the Load Balancer Type removal. After this date, the Load Balancer Type cannot be used anymore.
hidden fixed unavailable_after: tf.Computed<String> = tf.computed<String>(this, "unavailable_after")

/// The string that identifies the kind of this value.
///
/// This is an internal field.
hidden const $kind: "hcloud_load_balancer_type"
