/// Data source hcloud_certificate from terraform-provider-hcloud.
module providers.hetznercloud.hcloud.data.Certificate

extends "@tf/DataSource.pkl"

import "@tf/tf.pkl"

hidden fixed certificate: tf.Computed<String> = tf.computed<String>(this, "certificate")

hidden fixed created: tf.Computed<String> = tf.computed<String>(this, "created")

hidden fixed domain_names: tf.Computed<Listing<String>> =
  tf.computed<Listing<String>>(this, "domain_names")

hidden fixed fingerprint: tf.Computed<String> = tf.computed<String>(this, "fingerprint")

id: tf.Input<Number>?

hidden fixed labels: tf.Computed<Mapping<String, String>> =
  tf.computed<Mapping<String, String>>(this, "labels")

name: tf.Input<String>?

hidden fixed not_valid_after: tf.Computed<String> = tf.computed<String>(this, "not_valid_after")

hidden fixed not_valid_before: tf.Computed<String> = tf.computed<String>(this, "not_valid_before")

hidden fixed type: tf.Computed<String> = tf.computed<String>(this, "type")

with_selector: tf.Input<String>?

/// The string that identifies the kind of this value.
///
/// This is an internal field.
hidden const $kind: "hcloud_certificate"
