/// Provides details about a Hetzner Cloud Zone Resource Record Set (RRSet).
///
/// See the [Zone RRSets API documentation](https://docs.hetzner.cloud/reference/cloud#zone-rrsets) for more details.
module providers.hetznercloud.hcloud.data.ZoneRrset

extends "@tf/DataSource.pkl"

import "@tf/Referenceable.pkl"
import "@tf/tf.pkl"

/// Whether change protection is enabled.
hidden fixed change_protection: tf.Computed<Boolean> =
  tf.computed<Boolean>(this, "change_protection")

/// ID of the Zone RRSet.
id: tf.Input<String>?

/// User-defined [labels](https://docs.hetzner.cloud/reference/cloud#labels) (key-value pairs) for the resource.
hidden fixed labels: tf.Computed<Mapping<String, String>> =
  tf.computed<Mapping<String, String>>(this, "labels")

/// Name of the Zone RRSet.
name: tf.Input<String>?

/// Records of the Zone RRSet.
hidden fixed records: tf.Computed<Listing<Records>(isDistinct)> =
  tf.computed<Listing<Records>(isDistinct)>(this, "records")

/// Time To Live (TTL) of the Zone RRSet.
hidden fixed ttl: tf.Computed<Number> = tf.computed<Number>(this, "ttl")

/// Type of the Zone RRSet.
type: tf.Input<String>?

/// Filter results using a [Label Selector](https://docs.hetzner.cloud/reference/cloud#label-selector).
with_selector: tf.Input<String>?

/// ID or Name of the parent Zone.
zone: tf.Input<String>

class Records extends Referenceable {
  /// Comment of the record.
  comment: String

  /// Value of the record.
  value: String
}

/// The string that identifies the kind of this value.
///
/// This is an internal field.
hidden const $kind: "hcloud_zone_rrset"
