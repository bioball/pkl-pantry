/// Provides a list of Hetzner Cloud SSH Keys.
///
/// This resource is useful if you want to use a non-terraform managed SSH Key.
module providers.hetznercloud.hcloud.data.SshKeys

extends "@tf/DataSource.pkl"

import "@tf/Referenceable.pkl"
import "@tf/tf.pkl"

id: tf.Input<String>?

hidden fixed ssh_keys: tf.Computed<Listing<SshKeys>> =
  tf.computed<Listing<SshKeys>>(this, "ssh_keys")

/// Filter results using a [Label Selector](https://docs.hetzner.cloud/reference/cloud#label-selector).
with_selector: tf.Input<String>?

class SshKeys extends Referenceable {
  /// Fingerprint of the SSH Key.
  fingerprint: String

  /// User-defined [labels](https://docs.hetzner.cloud/reference/cloud#labels) (key-value pairs) for the resource.
  labels: Mapping<String, String>

  /// Name of the SSH Key.
  name: String

  /// Public key of the SSH Key pair.
  public_key: String
}

/// The string that identifies the kind of this value.
///
/// This is an internal field.
hidden const $kind: "hcloud_ssh_keys"
