module tf.codegen.BaseGen

import "@pkl.experimental.syntax/ExpressionNode.pkl"
import "@pkl.experimental.syntax/ModuleNode.pkl"
import "@pkl.experimental.syntax/TypeNode.pkl"

import "ProviderSchemaGen.pkl"
import "util.pkl"

providers: Listing<ProviderSchemaGen>

fixed providerImportPathsToAliases: Mapping<String, String> = new {
  for (provider in providers) {
    [provider.providerModuleOutputPath] =
      util.camelCase(provider.providerName + "Provider").capitalize()
  }
}

fixed moduleNode: ModuleNode = new {
  declaration {
    moduleHeader {
      moduleExtendsOrAmendsClause {
        type = "extends"
        extendedModule = "@tf/tf.pkl"
      }
    }
  }
  imports {
    new { value = "Providers.pkl" }
    new { value = "Resources.pkl" }
    new { value = "EphemeralResources.pkl" }
    new { value = "Data.pkl" }
  }
  properties {
    new {
      name {
        value = "provider"
      }
      docComment {
        value = "Terraform/OpenTofu provider configuration."
      }
      typeAnnotation {
        type = new TypeNode.DeclaredTypeNode {
          name = util.className("Providers")
        }
      }
    }
    new {
      name {
        value = "resource"
      }
      docComment {
        value = "Terraform/OpenTofu resource configuration."
      }
      typeAnnotation {
        type = new TypeNode.DeclaredTypeNode {
          name = util.className("Resources")
        }
      }
    }
    new {
      name {
        value = "ephemeral"
      }
      docComment {
        value = "Terraform/OpenTofu ephemeral resource configuration."
      }
      typeAnnotation {
        type = new TypeNode.DeclaredTypeNode {
          name = util.className("EphemeralResources")
        }
      }
    }
    new {
      name {
        value = "data"
      }
      docComment {
        value = "Terraform/OpenTofu data configuration."
      }
      typeAnnotation {
        type = new TypeNode.DeclaredTypeNode {
          name = util.className("Data")
        }
      }
    }
  }
}

output {
  text = util.formatPkl(moduleNode.output.text)
}
