/// Generates `Providers.pkl`, which defines all the providers used in the project.
module tf.codegen.ProvidersGen

import "@pkl.experimental.syntax/ModuleNode.pkl"
import "@pkl.experimental.syntax/TypeNode.pkl"

import "ProviderSchemaGen.pkl"
import "util.pkl"

providers: Listing<ProviderSchemaGen>

/// The names that the provider modules are imported as, in order of [providers].
///
/// This is the name of the provider with `Module`; e.g. `awsModule`. If another provider has that
/// name, it is prefixed with the organization; e.g. `hashicorpAwsModule`.
local importAliases: List<String> =
  providers
    .toList()
    .fold(Pair(List(), Set()), (acc, provider) ->
      let (
        name =
          util.firstAvailable(
            List(
              "\(provider.providerName)Module",
              "\(provider.providerPrefix.first)\(util.camelCase(provider.providerName))Module"
            ),
            acc.second
          )
      )
        Pair(acc.first + List(name), acc.second.add(name))
    )
    .first

fixed moduleNode: ModuleNode = new {
  declaration {
    moduleHeader {
      name = util.className("providers.Providers")
    }
  }
  imports {
    for (idx, provider in providers) {
      new {
        value = provider.providerModuleOutputPath.replaceFirst("providers/", "")
        alias = importAliases[idx]
      }
    }
  }
  properties {
    for (idx, provider in providers) {
      new {
        when (provider.providerSchema.provider.block.description != null) {
          docComment {
            value = provider.providerSchema.provider.block.description!!.trim()
          }
        }
        name { value = provider.providerName }
        typeAnnotation {
          type = new TypeNode.DeclaredTypeNode {
            name = util.className("\(importAliases[idx]).Provider")
          }
        }
      }
    }
  }
}

fixed moduleOutputPath: String = "providers/Providers.pkl"

output = moduleNode.output
