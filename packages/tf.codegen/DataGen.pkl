module tf.codegen.DataGen

import "@pkl.experimental.syntax/ModuleNode.pkl"
import "@pkl.experimental.syntax/TypeNode.pkl"

import "ProvidersSchema.pkl"
import "util.pkl"

dataSchema: ProvidersSchema.Schema

dataSourceName: String

/// The prefix to add to the module name
modulePrefix: String

/// The prefix for this file's output
filePrefix: String

/// The name of the provider
providerName: String

/// The classes of the nested objects of this module, and their names.
local layout = util.computeLayout(util.classes(dataSchema.block, false))

/// [util], with the names of the classes of this module.
local u = (util) {
  classNames = layout.names
  emittedClasses = layout.emitted
}

fixed pklName: String = util.convertResourceName(dataSourceName, providerName)

fixed moduleNode: ModuleNode = new {
  declaration {
    docComment {
      when (dataSchema.block.description != null) {
        value = util.fixComment(dataSchema.block.description!!)
      } else {
        value = "Data source \(dataSourceName) from terraform-provider-\(providerName)."
      }
    }
    moduleHeader {
      name = util.className("\(modulePrefix).data.\(pklName)")
      moduleExtendsOrAmendsClause {
        type = "extends"
        extendedModule = "@tf/DataSource.pkl"
      }
    }
  }
  imports {
    new {
      value = "@tf/tf.pkl"
    }
    // only the classes of nested objects need it
    when (!layout.emitted.isEmpty) {
      new {
        value = "@tf/Referenceable.pkl"
      }
    }
  }
  properties = u.renderProperties(dataSchema.block, null, false, false)

  classes {
    for (attributeName, attribute in dataSchema.block.attributes) {
      when (attribute.type != null) {
        ...u.renderObjectClasses(
          attribute.type!!,
          null,
          attributeName,
          false,
          attribute.isReadOnly()
        )
      } else {
        ...u.renderNestedTypeClasses(
          attribute.nested_type!!,
          null,
          attributeName,
          false,
          attribute.isReadOnly()
        )
      }
    }

    for (nestedBlockName, nestedBlock in dataSchema.block.block_types) {
      ...u.renderBlockClasses(
        nestedBlock,
        null,
        nestedBlockName,
        false
      )
    }
  }
}

fixed moduleOutputPath: String = "\(filePrefix)/data/\(pklName).pkl"

local kindProperty: ModuleNode.PropertyDefinitionNode = new {
  docComment {
    value =
      """
      The string that identifies the kind of this value.

      This is an internal field.
      """
  }
  name { value = "$kind" }
  modifiers { "hidden"; "const" }
  typeAnnotation {
    type = new TypeNode.StringLiteralTypeNode {
      value = dataSourceName
    }
  }
}

/// Goes at the end of the file, after the nested classes.
output {
  text =
    util.formatPkl(
      List(moduleNode.output.text, kindProperty.render("")).filterNonNull().join("\n\n")
    )
}
