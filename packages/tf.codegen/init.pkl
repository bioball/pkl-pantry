/// Initialize Pkl schemas for the current Terraform/OpenTofu project.
///
/// ## Prerequisites
///
/// * Terraform config folder with correct configuration that has at least this:
///   * `terraform.required_providers` config for your provider.
///   * empty `provider "providername" {}` block
/// * Run `terraform init`/`tofu init` to fetch provider binaries.
///
/// ## Running the generator
///
/// ```
/// terraform providers schema -json | pkl run package://pkg.pkl-lang.org/tf.codegen@1.0.0#/init.pkl
/// ```
///
/// ## Limitations
///
///  * Terraform schema for attributes using `SchemaConfigModeAttr` is limited, does not provide proper constraints,
///    all fields will be marked as optional.
module tf.init.init

extends "pkl:Command"

import "pkl:json"

import "BaseGen.pkl"
import "MappingsGen.pkl"
import "ProviderSchemaGen.pkl"
import "ProvidersGen.pkl"
import "ProvidersSchema.pkl"

options: Options

class Options {
  /// Convert and generate only selected resource.
  @Flag { metavar = "resource" }
  resource: Listing<String>

  /// TF provider schema json.
  ///
  /// Defaults to reading it from STDIN.
  input: String(!isBlank) = read("file:/dev/stdin").text
}

parsed: Mapping = new json.Parser { useMapping = true }.parse(options.input) as Mapping

converted: ProvidersSchema = ProvidersSchema.convert(parsed)

pwd = read("env:PWD")

local providerGens: Listing<ProviderSchemaGen> = new {
  for (providerName, provider in converted.provider_schemas) {
    new {
      fqdn = providerName
      providerSchema = provider
      selectResources = module.options.resource.toList()
    }
  }
}

local baseGen: BaseGen = new { providers = providerGens }

local providersGen: ProvidersGen = new { providers = providerGens }

local mappingGens: Listing<MappingsGen> = new {
  for (_kind in List("resource", "ephemeral", "data")) {
    new { providers = providerGens; kind = _kind }
  }
}

output {
  text = ""
  files {
    for (gen in providerGens) {
      ...gen.files
    }
    ["providers/base.pkl"] = baseGen.output
    [providersGen.moduleOutputPath] = providersGen.output
    for (gen in mappingGens) {
      [gen.moduleOutputPath] = gen.output
    }
  }
}
