amends ".../Workflow.pkl"

name = "build"

on = "push"

jobs {
  ["job1"] {
    `runs-on` = "ubuntu-latest"
    outputs {
      ["matrix"] = module.$steps["set-matrix"].outputs["matrix"]
    }
    steps {
      new {
        id = "set-matrix"
        run =
          """
          echo "matrix={\"include\":[{\"project\":\"foo\",\"config\":\"Debug\"},{\"project\":\"bar\",\"config\":\"Release\"}]}" >> $GITHUB_OUTPUT
          """
      }
    }
  }
  ["job2"] {
    needs = "job1"
    `runs-on` = "ubuntu-latest"
    strategy {
      matrix = module.$fromJSON(module.$needs["job1"].outputs["matrix"])
    }
    steps {
      new {
        run =
          """
          echo "Matrix - Project \(module.$matrix["project"]), Config: \(module.$matrix["config"])"
          """
      }
    }
  }
}
