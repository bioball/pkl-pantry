/// Base class for a Terraform/OpenTofu data source.
abstract module tf.DataSource

extends "Referenceable.pkl"

import "tf.pkl"

/// Specify which provider configuration to use for a resource.
///
/// This overrides Terraform's default behavior of selecting the provider based on the resource type name.
/// See [documentation](https://www.terraform.io/language/meta-arguments/depends_on).
provider: String(matches(Regex("^.+\\..+$")))?

/// Handle hidden resource or module dependencies that Terraform can't automatically infer.
///
/// Explicitly specifying a dependency is only necessary when a resource or module relies on some other resource's
/// behavior but doesn't access any of that resource's data in its arguments.
/// See [documentation](https://www.terraform.io/language/meta-arguments/resource-provider).
depends_on: Listing<String>(isDistinct)

/// Terraform will create that many instances of this resource.
///
/// Each instance has a distinct infrastructure object associated with it, and each is separately created, updated,
/// or destroyed when the configuration is applied.
/// See [documentation](https://www.terraform.io/language/meta-arguments/count).
count: tf.Input<UInt>? = null

/// The string that identifies the kind of this value; e.g. `aws_s3_bucket`.
///
/// This is an internal field.
hidden const $kind: String

hidden $path = new { "data"; $kind }
