/// Base class for a Terraform/OpenTofu resource
abstract module tf.Resource

extends "Referenceable.pkl"

import "tf.pkl"

/// Customize lifecycle behavior of a resource.
///
/// See [documentation](https://www.terraform.io/language/meta-arguments/lifecycle).
lifecycle: tf.Lifecycle?

/// The `for_each` meta-argument accepts a map or a set of strings and creates an instance for each item in that map or set.
///
/// See [documentation](https://developer.hashicorp.com/terraform/language/meta-arguments/for_each).
/// See [json config examples](https://discuss.hashicorp.com/t/for-each-for-expression-in-json-syntax/15185).
for_each: String?

/// Handle hidden resource or module dependencies that Terraform can't automatically infer.
///
/// Explicitly specifying a dependency is only necessary when a resource or module relies on some other resource's
/// behavior but doesn't access any of that resource's data in its arguments.
/// See [documentation](https://www.terraform.io/language/meta-arguments/depends_on).
depends_on: Listing<String>(isDistinct)

/// The string that identifies the kind of this value; e.g. `aws_s3_bucket`.
///
/// This is an internal field.
hidden const $kind: String

hidden $path = new { $kind }
