module tf.utils

import "tf.pkl"

function instanceOf(thing: Any, type: tf.PrimitiveType | tf.StructuralType): Boolean =
  if (type is "any")
    true
  else if (type is "string")
    thing is String
  else if (type is "number")
    thing is Number
  else if (type is "bool")
    thing is Boolean
  else if (type.structure is "list" | "set")
    (thing is Listing || thing is Collection)
      && (thing as Listing | Collection)
        .toList()
        .every((it) -> instanceOf(it, type.of as tf.PrimitiveType | tf.StructuralType))
  else if (type.structure is "map")
    (thing is Map || thing is Mapping)
      && (thing as Map | Mapping)
        .toMap()
        .entries
        .every((it) ->
          it.first is String
            && instanceOf(it.second, type.of as tf.PrimitiveType | tf.StructuralType)
        )
  else if (type.structure is "object")
    (thing is Dynamic || thing is Typed)
      && (thing as Dynamic | Typed)
        .toMap()
        .entries
        .every((it) ->
          it.first is String
            && let (ty = type.of.getOrNull(it.first) as (tf.PrimitiveType | tf.StructuralType)?)
              ty != null && instanceOf(it, ty)
        )
  else
    throw("Unrecognised type \(type)")
