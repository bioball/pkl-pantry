abstract module tf.ResourceWithTimeouts

extends "Resource.pkl"

/// Allows to customize timeouts for specific operations.
///
/// See [operation timeouts](https://developer.hashicorp.com/terraform/language/resources/syntax#operation-timeouts)
/// for further details.
timeouts: Timeouts?

/// Allows to customize timeouts for specific operations.
class Timeouts {
  /// Custom timeout applying to all operations.
  default: Duration?

  /// Custom timeout for `read` operations.
  `read`: Duration?

  /// Custom timeout for `create` operations.
  create: Duration?

  /// Custom timeout for `delete` operations.
  `delete`: Duration?

  /// Custom timeout for `update` operations.
  update: Duration?
}
