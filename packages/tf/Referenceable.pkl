abstract module tf.Referenceable

/// The path to this value.
///
/// A reference to a value is rendered from this path; for example, the path of the value
/// `foo.bar[0]` is `foo`, `bar`, and `0`.
///
/// This is an internal field.
hidden $path: Listing<String | Int>
